# RefactorSim local settings

# Public URL used for demo access through Cloudflare Tunnel.
APP_URL="https://rubytest.cjp-demo.online"

# Optional: set these to bootstrap or sync the first admin account on server start.
# If omitted, the app will show a first-run admin setup screen.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Required only when running the Cloudflare Tunnel connector through Docker Compose.
# Create a Cloudflare Tunnel for rubytest.cjp-demo.online and paste the token here.
CLOUDFLARED_TUNNEL_TOKEN="PASTE_CLOUDFLARE_TUNNEL_TOKEN_HERE"
